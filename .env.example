# Copy to .env and fill in. docker compose reads this file automatically.
# Never commit the real .env — it is already in .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Dashboard -> Settings -> API -> JWT Secret.
# Set it to verify HS256 tokens locally instead of calling the Auth API.
SUPABASE_JWT_SECRET=

# ─── AI pipeline ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-key
# Optional vision fallback for questions where text extraction fails.
VISION_API_KEY=
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080
# Comma-separated allow-list enforced in production.
CORS_ORIGINS=http://localhost:8080
PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/reset-password

# Baked into the frontend bundle at build time.
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# ─── Cache / queues ──────────────────────────────────────────────────────────
# Leave blank to use the in-process cache (fine for a single instance).
REDIS_URL=
LEADERBOARD_TTL_SECONDS=300

# ─── Attempt sweeper ─────────────────────────────────────────────────────────
# Finalises exams abandoned past their deadline.
ATTEMPT_SWEEP_INTERVAL_MS=60000
ATTEMPT_SWEEP_DISABLED=false
