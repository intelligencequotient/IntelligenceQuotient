# Copy to .env and fill in. docker compose reads this file automatically.
# Never commit the real .env — it is already in .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Used for user-facing auth (login, refresh, verifying a current password).
SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Dashboard -> Settings -> API -> JWT Secret.
# Set it to verify HS256 tokens locally instead of calling the Auth API.
SUPABASE_JWT_SECRET=

# ─── AI pipeline ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-key
# Optional vision fallback for questions where text extraction fails.
VISION_API_KEY=
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Interpreter used to run the PDF scripts. Defaults to python3 (python on Windows).
PYTHON_BIN=

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080
# Comma-separated allow-list. Enforced in production for both HTTP and
# WebSocket connections; the API refuses to start in production without it.
CORS_ORIGINS=http://localhost:8080
PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/reset-password

# Baked into the frontend bundle at build time.
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# ─── Cache / queues / scaling ────────────────────────────────────────────────
# Leave blank to use the in-process cache (fine for a SINGLE instance).
#
# Required before running more than one API replica: without it the throttler
# counts per-process, Socket.IO rooms do not span instances, and every replica
# runs the attempt sweeper independently.
REDIS_URL=
LEADERBOARD_TTL_SECONDS=300
COHORT_TTL_SECONDS=120

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Requests per minute, counted per authenticated user (per IP when anonymous).
# Sized for an exam client; raise if a legitimate flow starts hitting it.
THROTTLE_LIMIT=300
# Number of proxy hops to trust for the client IP. 1 for a single nginx/ELB.
TRUST_PROXY=1

# ─── Attempt sweeper ─────────────────────────────────────────────────────────
# Finalises exams abandoned past their deadline.
ATTEMPT_SWEEP_INTERVAL_MS=60000
ATTEMPT_SWEEP_DISABLED=false

# ─── API docs ────────────────────────────────────────────────────────────────
# Swagger is served in development automatically. In production it stays off
# unless this is explicitly 'true' — it publishes the full route and payload map.
ENABLE_SWAGGER=false
